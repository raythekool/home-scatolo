# ---- Server & Storage ----
PORT=3000
DB_PATH=/data/inventory.db

# Origini CORS consentite (aggiungi il tuo dominio Cloudflare Tunnel e/o GitHub Pages)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,https://raythekool.github.io

# Opzionale: se monti la PWA compilata in /app/public, il backend la serve direttamente su /
# PUBLIC_WEB_DIR=/app/public

# ---- Sicurezza & Autenticazione (/admin, PWA e API) ----
# Token master API (generato automaticamente da bootstrap-minipc.sh con `openssl rand -hex 32`)
APP_API_TOKEN=

# Password dedicata per il login web /admin (se vuota, accetta APP_API_TOKEN)
ADMIN_PASSWORD=

# Opzionale: segreto dedicato per firmare i cookie HttpOnly (default derivato da ADMIN_PASSWORD/APP_API_TOKEN)
# SESSION_SECRET=

# Opzione A (CONSIGLIATA su MiniPC): Cloudflare Access con Google IdP
# Verifica crittografica RS256 del JWT Cf-Access-Jwt-Assertion contro le JWKS del tuo team Cloudflare
# CF_ACCESS_TEAM_DOMAIN=tuoteam.cloudflareaccess.com
# CF_ACCESS_AUD=

# Opzione B: Google Social Login diretto (OAuth 2.0)
# Redirect URI autorizzato su Google Cloud Console: https://scatolo.tuodominio.it/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Email autorizzate per Google OAuth (obbligatorio per Opzione B; filtro extra opzionale per Opzione A)
# AUTH_ALLOWED_EMAILS=tua.email@gmail.com

# ---- AI Vision: Primario Cloud + Fallback Locale Ollama ----
# Provider supportati: github-models | anthropic | openai-compatible | ollama | azure-foundry
AI_PRIMARY_PROVIDER=github-models
AI_FALLBACK_PROVIDER=ollama

# 1) GitHub Models (consigliato come primario con abbonamento GitHub Copilot)
# Crea un fine-grained PAT con permesso "Models: read"
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o
# GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference/chat/completions

# 2) Alternativa primaria: Anthropic / Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# 3) Alternativa primaria: qualsiasi endpoint OpenAI-compatible
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# 4) Fallback locale: Ollama gia' attivo sul MiniPC
# Se Ollama e' esposto sull'host usa host.docker.internal; se e' nella stessa rete Docker usa http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Consigliati per Intel N97 / 16 GB RAM: qwen2.5vl:3b oppure gemma3:4b
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_MS=90000
